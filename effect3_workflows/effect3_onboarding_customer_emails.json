    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst body = request.body || {};\nconst formType = String(body.formType || '').trim();\nconst email = String(body.email || '').trim();\nconst name = String(body.name || '').trim();\nconst brandName = String(body.brandName || '').trim();\nconst problem = String(body.problem || '').replace(/\\s+/g, ' ').trim();\n\nif (formType !== 'onboarding') {\n  throw new Error('Unsupported formType.');\n}\n\nif (!email) {\n  throw new Error('Missing onboarding email address.');\n}\n\nreturn [{\n  json: {\n    email,\n    name,\n    brandName,\n    problem,\n    mode: String(body.mode || '').trim(),\n    submittedAt: String(body.submittedAt || new Date().toISOString()),\n    pagePath: String(body.pagePath || '').trim()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        320
      ],
      "id": "normalize-submission",
      "name": "Normalize Onboarding Submission"
