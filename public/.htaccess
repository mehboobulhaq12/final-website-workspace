DirectoryIndex index.html
FileETag None

<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^projects/?$ /case-studies/ [R=301,L]
  RewriteRule ^projects/(.+)/?$ /case-studies/$1/ [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <Files "index.html">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </Files>

  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
